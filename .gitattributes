# Text is kept with LF line endings on every platform: the build copies the sources into dist/ byte for byte, and CI
# checks dist/ against a fresh build, so a checkout that turned LF into CRLF (Windows, core.autocrlf) would not match.
* text=auto eol=lf
# never touched by line-ending conversion
*.woff2 binary
*.png binary
*.jpg binary
*.npz binary
*.ckpt binary
# built files and data: one long line each, not worth diffing as text
dist/** -diff linguist-generated
model/nib-data.json -diff
test/school_synth.jsonl -diff
test/fixtures/*.json -diff
package-lock.json -diff linguist-generated
